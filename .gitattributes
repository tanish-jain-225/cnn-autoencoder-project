# Auto-detect text files and normalize line endings to LF by default
* text=auto

# Windows batch scripts must have CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must have LF line endings
*.sh text eol=lf

# Python, HTML, CSS, JS, JSON
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ipynb text eol=lf
